# Copiez ce fichier en .env.local et renseignez vos clés Supabase
# (Dashboard Supabase > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=VOTRE_CLE_ANON

# Clé service_role — SERVEUR UNIQUEMENT (jamais NEXT_PUBLIC).
# Nécessaire pour que le promoteur crée des comptes comptables.
# Dashboard Supabase > Project Settings > API > service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=VOTRE_CLE_SERVICE_ROLE
